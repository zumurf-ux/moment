rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /editions/{editionId} {
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /appConfig/{platform} { allow read: if true; allow write: if isAdmin(); }
    match /{collection}/{document} {
      allow read, write: if isAdmin() && collection in ['candidates','sources','auditLogs'];
    }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
